# ─────────────────────────────────────────────────────────────
# WAHA (gateway de WhatsApp)
# ─────────────────────────────────────────────────────────────
# URL base de tu WAHA. Desde WAHA 2026.6.1 un solo contenedor gratis
# maneja todas las sesiones y comparten esta URL.
# En Easypanel puedes usar la URL interna del servicio WAHA para no salir
# a internet, o la URL pública que ya tienes.
WAHA_URL=https://bots-waha.cakkmp.easypanel.host
WAHA_API_KEY=cambia-esta-clave

# URL PÚBLICA de ESTE orquestador (para que WAHA le entregue los webhooks).
# En Easypanel: el dominio que te asigna al crear la App, ej:
#   https://bots-orquestador.cakkmp.easypanel.host
PUBLIC_URL=https://bots-orquestador.cakkmp.easypanel.host

# Puerto interno del orquestador (Easypanel debe apuntar a este puerto)
PORT=8080

# ─────────────────────────────────────────────────────────────
# Números de las cuentas (formato internacional, solo dígitos)
# Para empezar con 2 cuentas basta con ana y beto.
# ─────────────────────────────────────────────────────────────
NUM_ANA=52xxxxxxxxxx
NUM_BETO=52xxxxxxxxxx
# NUM_CARO=
# NUM_DIEGO=
# ... (agrega el resto cuando escales a 10)

# ─────────────────────────────────────────────────────────────
# Gemini (IA que genera las respuestas) — motor barato
# API key gratis en https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
# Modelo barato vigente para cuentas nuevas.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_TOKENS=280

# ─────────────────────────────────────────────────────────────
# Panel web
# ─────────────────────────────────────────────────────────────
# Token para proteger el panel (QR/seed) en un servidor público.
# Entrarás con  https://.../?token=EL_TOKEN
DASHBOARD_TOKEN=ponme-un-token-secreto

# ─────────────────────────────────────────────────────────────
# Comportamiento de la conversación (anti-baneo y control de costo)
# ─────────────────────────────────────────────────────────────
DELAY_MIN_MS=4000
DELAY_MAX_MS=12000
MAX_TURNS_PER_PAIR=20
COOLDOWN_MS=1800000
ONLY_AMONG_BOTS=true
ALLOW_GROUPS=false
HISTORY_LIMIT=12
